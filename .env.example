# ESS Dashboard environment — copy to `.env` and fill in.
# Anything marked GEN needs a fresh generated value, never reuse defaults.

# ============ backend (FastAPI) ============
ENV=production
DATABASE_URL=postgresql+asyncpg://ess:ess@db:5432/ess
# GEN: openssl rand -hex 32
SECRET_JWT_KEY=GEN
ACCESS_TOKEN_TTL_MINUTES=15
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Dashboard origins (scheme+host, explicit; never "*" when credentials are used)
CORS_ORIGINS=http://localhost:3000
# Seed admin (change password after first login!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GEN-admin-password-8+
# GEN: python -c "import secrets; print('ess_gw_' + secrets.token_hex(24))"
GATEWAY_API_KEY=GEN
GATEWAY_ID=primary
SIMULATED_TELEMETRY_REJECTED=true
RATE_LIMIT_INGEST_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_GLOBAL_PER_MINUTE=600
MAX_BODY_BYTES=65536
MAX_HISTORY_RANGE_DAYS=90
LATEST_LIMIT_MAX=200
HISTORY_LIMIT_MAX=5000
WS_MAX_CONNECTIONS=200
DEVICE_FRESHNESS_TIMEOUT_SECONDS=900
TEMP_HIGH_THRESHOLD_C=35
TEMP_HYSTERESIS_C=2
TEMP_SUSTAINED=2
HUMIDITY_HIGH_THRESHOLD=85
HUMIDITY_HYSTERESIS=3
HUMIDITY_SUSTAINED=3
MQ2_THRESHOLD_RAW=800
MQ2_HYSTERESIS=100
MQ2_SUSTAINED=2
WATER_SENSOR_SUSTAINED=1
SENSOR_MALFUNCTION_SUSTAINED=3
DEVICE_OFFLINE_SUSTAINED=1

# ============ gateway (Raspberry Pi; same GATEWAY_API_KEY as backend) ============
BACKEND_URL=http://backend:8000
# Per-node HMAC keys, "id:hex16,id:hex16" — must match each node's NODE_KEY_HEX
NODE_KEYS=101:GEN-node-key-32hex,102:GEN-node-key-32hex
GATEWAY_BUFFER_DB=/var/lib/ess-gateway/buffer.sqlite3
# Radio (must equal ess_node/config.h). Frequency obeys local ISM regulations.
LORA_FREQUENCY_MHZ=868.10
LORA_SPREADING_FACTOR=7
LORA_BANDWIDTH_KHZ=125
LORA_CODING_RATE=5
LORA_TX_POWER_DBM=14
LORA_SPI_BUS=0
LORA_SPI_CS=0
LORA_DIO0_GPIO=17
LORA_RST_GPIO=22
RETRY_MAX=6
RETRY_BACKOFF_BASE=1.5
RETRY_BACKOFF_MAX=60
TLS_VERIFY=true
# Simulator mode (no physical radio). Set false on a real Raspberry Pi.
SIMULATE=true
SIMULATE_DEVICE_IDS=101,102
SIMULATE_INTERVAL_SECONDS=5

# ============ frontend (Next.js; NEXT_PUBLIC_* are build-time) ============
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000/api/v1
NEXT_PUBLIC_DEMO_MODE=false
