# Frontend runtime configuration (baked at build time; restart dev server after changes)
# Base URL of the ESS backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# WebSocket base (ws:// or wss://); defaults derived from API base if unset
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000/api/v1
# Run the dashboard fully in-browser with simulated data (no backend needed)
NEXT_PUBLIC_DEMO_MODE=false
